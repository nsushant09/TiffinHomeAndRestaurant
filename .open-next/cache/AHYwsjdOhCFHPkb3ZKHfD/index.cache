 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/rooms\">Rooms</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/restaurant\">Restaurant</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/tours\">Experiences</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/story\">Our story</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/location\">Contact</a></nav><div class=\"flex items-center justify-self-end gap-2\"><div tabindex=\"0\"><a class=\"btn-primary hidden !px-5 !py-3 sm:flex\" href=\"/rooms\">Book a stay <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div><button class=\"icon-control grid h-11 w-11 place-items-center rounded-full border border-forest-950/15 text-forest-950 transition-colors duration-300 hover:border-forest-700 hover:bg-forest-700 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-forest-600/15 lg:hidden\" aria-label=\"Open menu\" aria-expanded=\"false\" tabindex=\"0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main><section class=\"relative overflow-hidden border-b border-forest-900/10\"><div class=\"mx-auto grid min-h-[calc(100svh-4.75rem)] max-w-[90rem] items-center gap-12 px-5 py-14 lg:grid-cols-[.82fr_1.18fr] lg:px-10 lg:py-16\"><div class=\"relative z-10 max-w-2xl\"><div class=\"inline-flex items-center gap-2 text-sm font-medium text-forest-800\" style=\"opacity:0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg> Sauraha, Chitwan, Nepal</div><div class=\"mt-7 overflow-hidden\"><h1 class=\"text-[clamp(3.1rem,6.8vw,6.9rem)] font-bold leading-[.96] tracking-[-0.055em] text-forest-950\" style=\"transform:translateY(105%)\">Feel at home, close to the wild.</h1></div><p class=\"mt-7 max-w-xl text-[17px] font-normal leading-8 text-stone-600\" style=\"opacity:0;transform:translateY(12px)\">A small family-run lodge for slow mornings, home-cooked food and days spent exploring Sauraha and Chitwan.</p><div class=\"mt-8 flex flex-wrap gap-3\" style=\"opacity:0\"><a class=\"btn-primary\" href=\"/rooms\">Explore the rooms <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"btn-outline\" href=\"/story\">Meet the family</a></div><p class=\"mt-10 border-l-2 border-[#bd7c52] pl-4 text-sm font-medium leading-6 text-stone-500\" style=\"opacity:0\">Welcoming guests in Sauraha for more than 20 years.</p></div><div class=\"relative h-[52svh] min-h-[430px] overflow-hidden rounded-[6rem_1.5rem_1.5rem_1.5rem] bg-forest-100 lg:h-[calc(100svh-8rem)] lg:min-h-[610px] lg:[border-radius:42%_1.5rem_1.5rem_42%/28%_1.5rem_1.5rem_28%]\" style=\"clip-path:inset(0 100% 0 0)\"><div class=\"absolute -inset-3\" style=\"transform:scale(1.035)\"><img alt=\"A comfortable room at Tiffin Home in Sauraha\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 bg-forest-950/25\" aria-hidden=\"true\"></div></div></div></section><section class=\"mx-auto grid max-w-[90rem] gap-12 px-5 py-24 lg:grid-cols-[.72fr_1.28fr] lg:px-10 lg:py-36\"><div><p class=\"text-sm font-medium text-[#a75536]\">A family place, since the beginning</p><p class=\"mt-5 max-w-sm text-2xl font-semibold leading-9 tracking-[-0.025em] text-forest-950\">Tiffin began as a restaurant more than two decades ago.</p></div><div><h2 class=\"max-w-4xl text-4xl font-bold leading-[1.12] tracking-[-0.04em] text-stone-900 sm:text-5xl\">It grew naturally into a small lodge, while staying what it always was: personal, welcoming and centred around food.</h2><div class=\"mt-10 grid gap-7 border-t border-stone-300 pt-7 sm:grid-cols-3\"><div><strong class=\"text-3xl font-semibold text-forest-800\">20+</strong><p class=\"mt-2 text-sm leading-6 text-stone-500\">years in Sauraha</p></div><div><strong class=\"text-3xl font-semibold text-forest-800\">10</strong><p class=\"mt-2 text-sm leading-6 text-stone-500\">standard and deluxe rooms</p></div><div><strong class=\"text-3xl font-semibold text-forest-800\">10 min</strong><p class=\"mt-2 text-sm leading-6 text-stone-500\">walk to the Rapti River</p></div></div></div></section><section class=\"bg-[#efe6d7] py-24 lg:py-32\"><div class=\"mx-auto max-w-[90rem] px-5 lg:px-10\"><div class=\"flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between\"><div><p class=\"text-sm font-medium text-[#a75536]\">Stay at Tiffin</p><h2 class=\"mt-3 max-w-2xl text-4xl font-bold tracking-[-0.04em] text-forest-950 sm:text-5xl\">A comfortable base for days outside.</h2></div><a class=\"link-action shrink-0 text-sm font-semibold text-forest-800 hover:text-forest-600\" href=\"/rooms\">See every room <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"mt-12 grid gap-10 lg:grid-cols-12 lg:items-stretch lg:gap-8\"><a class=\"group flex flex-col lg:col-span-7\" href=\"/rooms/standard-twin\"><div class=\"aspect-[16/10] overflow-hidden rounded-[2rem_5rem_2rem_2rem] bg-stone-200\"><img alt=\"Standard Twin or Double room\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2914.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"mt-5 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end\"><div><h3 class=\"text-2xl font-semibold tracking-[-0.025em] transition-colors duration-300 group-hover:text-forest-700\">Standard Twin / Double</h3><p class=\"mt-2 text-sm leading-6 text-stone-600\">One single and one double bed · 1–3 guests</p></div><span class=\"link-action text-sm font-semibold text-forest-800 group-hover:text-forest-600\">View room <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><div class=\"grid gap-10 lg:col-span-5 lg:grid-rows-2 lg:gap-8\"><a class=\"group grid gap-5 sm:grid-cols-[1.05fr_.95fr] sm:items-center lg:h-full\" href=\"/rooms/standard-king\"><div class=\"aspect-[4/3] overflow-hidden rounded-[1.5rem_1.5rem_1.5rem_4rem] bg-stone-200 lg:h-full lg:aspect-auto\"><img alt=\"Standard King room\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-king%2FIMG_2916.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"flex min-w-0 flex-col items-start justify-center py-2\"><h3 class=\"text-xl font-semibold tracking-[-0.02em] transition-colors duration-300 group-hover:text-forest-700\">Standard King</h3><p class=\"mt-2 text-sm leading-6 text-stone-600\">One king-size bed · 1–2 guests</p><span class=\"link-action mt-5 text-sm font-semibold text-forest-800 group-hover:text-forest-600\">View room <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a><a class=\"group grid gap-5 sm:grid-cols-[1.05fr_.95fr] sm:items-center lg:h-full\" href=\"/rooms/deluxe\"><div class=\"aspect-[4/3] overflow-hidden rounded-[4rem_1.5rem_1.5rem_1.5rem] bg-stone-200 lg:h-full lg:aspect-auto\"><img alt=\"Deluxe room\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"flex min-w-0 flex-col items-start justify-center py-2\"><h3 class=\"text-xl font-semibold tracking-[-0.02em] transition-colors duration-300 group-hover:text-forest-700\">Deluxe Room</h3><p class=\"mt-2 text-sm leading-6 text-stone-600\">A little more room · couples and families</p><span class=\"link-action mt-5 text-sm font-semibold text-forest-800 group-hover:text-forest-600\">View room <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></div></a></div></div></div></section><section class=\"bg-[#b96343] text-white\"><div class=\"mx-auto grid max-w-[90rem] lg:grid-cols-2\"><div class=\"aspect-[4/3] overflow-hidden sm:aspect-[16/10] lg:aspect-auto lg:min-h-[680px]\"><img alt=\"A room at Tiffin Home\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2922.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"flex items-center px-5 py-20 sm:px-8 lg:px-16\"><div class=\"max-w-xl\"><p class=\"text-sm font-medium text-orange-100\">The Tiffin story</p><h2 class=\"mt-5 text-4xl font-bold leading-[1.12] tracking-[-0.04em] sm:text-5xl\">A restaurant first. A lodge later. A family business throughout.</h2><p class=\"mt-7 text-[17px] leading-8 text-orange-50/85\">The property now has 10 rooms, but the purpose has stayed simple: comfortable accommodation, freshly prepared food and a warm, personal experience while guests explore Chitwan.</p><a class=\"btn-light mt-8\" href=\"/story\">Read our story <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section class=\"mx-auto grid max-w-[90rem] gap-14 px-5 py-24 lg:grid-cols-[.85fr_1.15fr] lg:px-10 lg:py-36\"><div class=\"lg:py-8\"><p class=\"text-sm font-medium text-[#a75536]\">From the kitchen</p><h2 class=\"mt-4 text-4xl font-bold leading-[1.12] tracking-[-0.04em] sm:text-5xl\">Meals are made when you order them.</h2><p class=\"mt-6 max-w-lg text-[17px] leading-8 text-stone-600\">Breakfast before a safari, something warm after a jungle walk, or an easy dinner at the end of the day. The restaurant is open daily from 8:00 AM to 10:00 PM.</p><a class=\"mt-8 inline-flex items-center gap-2 border-b border-forest-700 pb-1 text-sm font-semibold text-forest-800\" href=\"/restaurant\">Read the menu <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"grid grid-cols-[1.25fr_.75fr] gap-4\"><div class=\"aspect-[4/5] overflow-hidden rounded-[2rem_2rem_7rem_2rem]\"><img alt=\"Tiffin Home room\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_3031.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col justify-end rounded-[6rem_2rem_2rem_2rem] bg-forest-800 p-7 text-white\"><p class=\"text-4xl font-semibold\">8–10</p><p class=\"mt-2 text-sm leading-6 text-forest-100/75\">Restaurant hours, every day</p></div></div></section><section class=\"border-y border-forest-900/10 bg-forest-50/70\"><div class=\"mx-auto max-w-[90rem] px-5 py-20 lg:px-10\"><div class=\"grid gap-10 lg:grid-cols-[.65fr_1.35fr]\"><div><p class=\"text-sm font-medium text-[#a75536]\">Around Sauraha</p><h2 class=\"mt-3 text-3xl font-bold tracking-[-0.035em] text-forest-950\">Wildlife, river and village life are close by.</h2></div><div class=\"grid gap-x-10 sm:grid-cols-2\"><a class=\"group flex items-center justify-between border-b border-forest-900/15 py-5 text-base font-medium text-forest-950 transition-colors duration-300 hover:border-forest-600 hover:text-forest-700\" href=\"/tours\"><span>Jungle and jeep safaris</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-forest-700 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a><a class=\"group flex items-center justify-between border-b border-forest-900/15 py-5 text-base font-medium text-forest-950 transition-colors duration-300 hover:border-forest-600 hover:text-forest-700\" href=\"/tours\"><span>Canoeing and bird watching</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-forest-700 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a><a class=\"group flex items-center justify-between border-b border-forest-900/15 py-5 text-base font-medium text-forest-950 transition-colors duration-300 hover:border-forest-600 hover:text-forest-700\" href=\"/tours\"><span>Tharu cultural experiences</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-forest-700 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a><a class=\"group flex items-center justify-between border-b border-forest-900/15 py-5 text-base font-medium text-forest-950 transition-colors duration-300 hover:border-forest-600 hover:text-forest-700\" href=\"/tours\"><span>Rapti River sunsets</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-forest-700 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div></div></div></section><section class=\"px-5 py-20 lg:px-10 lg:py-28\"><div class=\"mx-auto flex max-w-[90rem] flex-col items-start justify-between gap-8 rounded-[2rem_5rem_2rem_2rem] bg-forest-800 px-7 py-12 text-white sm:flex-row sm:items-center sm:px-12\"><div><p class=\"text-sm font-medium text-forest-200\">Planning a stay in Sauraha?</p><h2 class=\"mt-3 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-4xl\">Choose your room and send a reservation request.</h2></div><a class=\"btn-warm shrink-0\" href=\"/rooms\">Check the rooms</a></div></section><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LodgingBusiness\",\"name\":\"Tiffin Home & Restaurant\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Sauraha\",\"addressRegion\":\"Chitwan\",\"addressCountry\":\"NP\"},\"telephone\":\"9845160919\",\"email\":\"tiffinhousesauraha@gmail.com\"}</script><!--$--><!--/$--></main><footer class=\"overflow-hidden bg-forest-950 text-white\"><div class=\"mx-auto max-w-[90rem] px-5 py-14 lg:px-10 lg:py-20\"><div class=\"grid gap-10 border-b border-white/10 pb-14 lg:grid-cols-[.65fr_1.35fr] lg:items-end lg:pb-16\"><a aria-label=\"Tiffin Home and Restaurant, home page\" class=\"group w-fit\" href=\"/\"><span class=\"relative block h-20 w-20 sm:h-24 sm:w-24\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain brightness-0 invert transition-transform duration-500 ease-out group-hover:rotate-[-3deg] group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"96px\" srcSet=\"/_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=384&a