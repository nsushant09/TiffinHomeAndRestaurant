-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/rooms\">Rooms</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/restaurant\">Restaurant</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/tours\">Experiences</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-forest-800 after:scale-x-0\" href=\"/story\">Our story<span class=\"absolute inset-x-0 -bottom-0.5 h-px bg-forest-700\"></span></a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/location\">Contact</a></nav><div class=\"flex items-center justify-self-end gap-2\"><div tabindex=\"0\"><a class=\"btn-primary hidden !px-5 !py-3 sm:flex\" href=\"/rooms\">Book a stay <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div><button class=\"icon-control grid h-11 w-11 place-items-center rounded-full border border-forest-950/15 text-forest-950 transition-colors duration-300 hover:border-forest-700 hover:bg-forest-700 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-forest-600/15 lg:hidden\" aria-label=\"Open menu\" aria-expanded=\"false\" tabindex=\"0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main><section class=\"border-b border-white/10 bg-forest-950 text-white\"><div class=\"mx-auto max-w-[90rem] px-5 py-20 lg:px-10 lg:py-28\"><p class=\"text-sm font-medium text-[#d49a75]\">Our story</p><h1 class=\"mt-5 max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl\">A family business that grew with Sauraha.</h1><p class=\"mt-7 max-w-2xl text-[17px] font-normal leading-8 text-forest-100/70\">Tiffin began as a restaurant more than 20 years ago. The lodge came later, but the welcome has always been personal.</p></div></section><section class=\"mx-auto max-w-[90rem] px-5 py-20 lg:px-10 lg:py-32\"><div class=\"grid items-center gap-14 lg:grid-cols-[1.1fr_.9fr]\"><div class=\"grid gap-4 sm:grid-cols-[.9fr_1.1fr]\"><div class=\"aspect-[4/3] overflow-hidden rounded-[4rem_1.5rem_1.5rem_1.5rem] sm:mt-16 sm:aspect-[4/5] sm:rounded-[5rem_1.5rem_1.5rem_1.5rem]\"><img alt=\"A standard room at Tiffin Home\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-twin%2FIMG_2916.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"aspect-[4/3] overflow-hidden rounded-[1.5rem_1.5rem_4rem_1.5rem] sm:aspect-[4/5] sm:rounded-[1.5rem_1.5rem_5rem_1.5rem]\"><img alt=\"A deluxe room at Tiffin Home\" loading=\"lazy\" width=\"1200\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-cover\" style=\"color:transparent\" sizes=\"(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fdeluxe%2FIMG_2921.jpeg&amp;w=3840&amp;q=75\"/></div></div><div><p class=\"text-sm font-medium text-[#a75536]\">More than two decades here</p><h2 class=\"mt-4 text-4xl font-bold leading-[1.13] tracking-[-0.04em] text-forest-950 sm:text-5xl\">The restaurant came first. Hospitality followed naturally.</h2><div class=\"mt-7 space-y-5 text-base leading-8 text-stone-600\"><p>Tiffin is a family-run business with more than 20 years of history in Sauraha, Chitwan. It originally started as a restaurant and grew over the years into a small hotel and restaurant.</p><p>The property now has 10 rooms, including standard and deluxe rooms, while continuing to operate as a family business.</p></div></div></div></section><section class=\"bg-forest-950 text-white\"><div class=\"mx-auto grid max-w-[90rem] gap-12 px-5 py-20 lg:grid-cols-2 lg:px-10 lg:py-28\"><p class=\"max-w-xl text-3xl font-semibold leading-[1.35] tracking-[-0.03em]\">“Our aim is to provide comfortable accommodation, freshly prepared food and a warm, personal experience.”</p><div class=\"max-w-xl lg:pt-2\"><p class=\"text-base leading-8 text-forest-100/70\">That aim is still the clearest way to understand Tiffin: not a large resort, but a small local place to sleep, eat and begin exploring Chitwan.</p><a class=\"mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[#e7b18e]\" href=\"/rooms\">See the rooms <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section><section class=\"mx-auto grid max-w-[90rem] gap-10 px-5 py-20 sm:grid-cols-3 lg:px-10 lg:py-28\"><div class=\"border-t border-stone-300 pt-6\"><h3 class=\"text-xl font-semibold text-forest-950\">Home-cooked food</h3><p class=\"mt-3 text-sm leading-7 text-stone-500\">Meals prepared to order in the restaurant where the business began.</p></div><div class=\"border-t border-stone-300 pt-6\"><h3 class=\"text-xl font-semibold text-forest-950\">Ten comfortable rooms</h3><p class=\"mt-3 text-sm leading-7 text-stone-500\">Standard and deluxe accommodation for couples, families and small groups.</p></div><div class=\"border-t border-stone-300 pt-6\"><h3 class=\"text-xl font-semibold text-forest-950\">A personal welcome</h3><p class=\"mt-3 text-sm leading-7 text-stone-500\">A small property that remains family-run after more than 20 years.</p></div></section><!--$--><!--/$--></main><footer class=\"overflow-hidden bg-forest-950 text-white\"><div class=\"mx-auto max-w-[90rem] px-5 py-14 lg:px-10 lg:py-20\"><div class=\"grid gap-10 border-b border-white/10 pb-14 lg:grid-cols-[.65fr_1.35fr] lg:items-end lg:pb-16\"><a aria-label=\"Tiffin Home and Restaurant, home page\" class=\"group w-fit\" href=\"/\"><span class=\"relative block h-20 w-20 sm:h-24 sm:w-24\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain brightness-0 invert transition-transform duration-500 ease-out group-hover:rotate-[-3deg] group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"96px\" srcSet=\"/_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Fl