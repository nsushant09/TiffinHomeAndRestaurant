><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 border-b border-forest-950/10 bg-[#fbf8f1]/95 backdrop-blur-xl\"><div class=\"mx-auto grid h-[4.75rem] max-w-[90rem] grid-cols-[1fr_auto] items-center px-5 lg:grid-cols-[1fr_auto_1fr] lg:px-10\"><a class=\"group flex w-fit items-center\" aria-label=\"Tiffin Home and Restaurant, home page\" href=\"/\"><span class=\"relative h-12 w-12 shrink-0\"><img alt=\"\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain transition-transform duration-300 ease-out group-hover:rotate-[-3deg] group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"48px\" srcSet=\"/_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Flogo%2Ftiffin-mark.png&amp;w=3840&amp;q=75\"/></span></a><nav class=\"hidden items-center gap-7 lg:flex\" aria-label=\"Main navigation\"><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/rooms\">Rooms</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/restaurant\">Restaurant</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/tours\">Experiences</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-stone-600 after:scale-x-0 hover:text-forest-800 hover:after:scale-x-100\" href=\"/story\">Our story</a><a class=\"group relative py-2 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-forest-700 after:transition-transform after:duration-300 text-forest-800 after:scale-x-0\" href=\"/location\">Contact<span class=\"absolute inset-x-0 -bottom-0.5 h-px bg-forest-700\"></span></a></nav><div class=\"flex items-center justify-self-end gap-2\"><div tabindex=\"0\"><a class=\"btn-primary hidden !px-5 !py-3 sm:flex\" href=\"/rooms\">Book a stay <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div><button class=\"icon-control grid h-11 w-11 place-items-center rounded-full border border-forest-950/15 text-forest-950 transition-colors duration-300 hover:border-forest-700 hover:bg-forest-700 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-forest-600/15 lg:hidden\" aria-label=\"Open menu\" aria-expanded=\"false\" tabindex=\"0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main><section class=\"border-b border-white/10 bg-forest-950 text-white\"><div class=\"mx-auto max-w-[90rem] px-5 py-20 lg:px-10 lg:py-28\"><p class=\"text-sm font-medium text-[#d49a75]\">Location and contact</p><h1 class=\"mt-5 max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl\">Find us in Sauraha.</h1><p class=\"mt-7 max-w-2xl text-[17px] font-normal leading-8 text-forest-100/70\">Close to the Rapti River, sunset viewpoints and the wildlife landscape around Chitwan National Park.</p></div></section><section class=\"mx-auto max-w-[90rem] px-5 py-20 lg:px-10 lg:py-28\"><div class=\"grid gap-16 lg:grid-cols-[.72fr_1.28fr] lg:gap-20\"><div><p class=\"text-sm font-medium text-[#a75536]\">A quiet base for days outside</p><h2 class=\"mt-4 text-4xl font-bold leading-[1.12] tracking-[-0.04em] text-forest-950 sm:text-5xl\">About ten minutes from the Rapti River on foot.</h2><p class=\"mt-6 text-base leading-8 text-stone-600\">Tiffin Home &amp; Restaurant is in Sauraha, Chitwan, Nepal, with convenient access to the national park and surrounding wildlife area. The exact GPS pin is still to be confirmed.</p><div class=\"mt-10 border-y border-stone-300\"><div class=\"grid grid-cols-[2.75rem_1fr] gap-4 border-b border-stone-200 py-5 last:border-b-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin mt-1 text-[#a75536]\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><div><p class=\"text-xs font-semibold text-stone-500\">Location</p><p class=\"mt-1 text-base font-medium leading-7 text-stone-800\">Sauraha, Chitwan, Nepal</p></div></div><div class=\"grid grid-cols-[2.75rem_1fr] gap-4 border-b border-stone-200 py-5 last:border-b-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone mt-1 text-[#a75536]\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg><div><p class=\"text-xs font-semibold text-stone-500\">Phone</p><a href=\"tel:9845160919\" class=\"mt-1 block text-base font-medium text-forest-800 hover:text-forest-600\">9845160919 · international format TBD</a></div></div><div class=\"grid grid-cols-[2.75rem_1fr] gap-4 border-b border-stone-200 py-5 last:border-b-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail mt-1 text-[#a75536]\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg><div><p class=\"text-xs font-semibold text-stone-500\">Email</p><a href=\"mailto:tiffinhousesauraha@gmail.com\" class=\"mt-1 block break-all text-base font-medium text-forest-800 hover:text-forest-600\">tiffinhousesauraha@gmail.com</a></div></div><div class=\"grid grid-cols-[2.75rem_1fr] gap-4 border-b border-stone-200 py-5 last:border-b-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock-3 mt-1 text-[#a75536]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6h4\"></path></svg><div><p class=\"text-xs font-semibold text-stone-500\">Restaurant hours</p><p class=\"mt-1 text-base font-medium leading-7 text-stone-800\">8:00 AM – 10:00 PM daily</p></div></div></div><a href=\"mailto:tiffinhousesauraha@gmail.com\" class=\"link-action mt-7 text-sm font-semibold text-forest-800 hover:text-forest-600\">Prefer email? Write to us directly <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div><div class=\"relative overflow-hidden rounded-[1.5rem_5rem_1.5rem_1.5rem] border border-stone-300 bg-white p-6 sm:p-10 lg:p-12\"><div class=\"absolute right-0 top-0 h-28 w-28 rounded-bl-[5rem] bg-[#efe6d7]\" aria-hidden=\"true\"></div><div class=\"relative\"><p class=\"text-sm font-medium text-[#a75536]\">Send a message</p><h2 class=\"mt-3 max-w-xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-forest-950 sm:text-4xl\">Ask about a room, a group stay or getting here.</h2><p class=\"mt-4 max-w-xl text-sm leading-7 text-stone-500\">Share what you need and how we should reach you. We’ll reply personally.</p><div class=\"mt-10 border-t border-stone-200 pt-9\"><form class=\"grid gap-7\"><div class=\"grid gap-7 sm:grid-cols-2\"><div><label for=\"general-fullName\" class=\"!mb-0 text-xs font-semibold text-stone-500\">Your name</label><input class=\"w-full !rounded-none !border-x-0 !border-t-0 !border-stone-300 !bg-transparent !px-0 !py-3 text-[15px] !shadow-none focus:!border-forest-700 focus:!ring-0\" id=\"general-fullName\" autoComplete=\"name\" placeholder=\"Full name\" required=\"\" name=\"fullName\"/></div><div><label for=\"general-email\" class=\"!mb-0 text-xs font-semibold text-stone-500\">Email address</label><input class=\"w-full !rounded-none !border-x-0 !border-t-0 !border-stone-300 !bg-transparent !px-0 !py-3 text-[15px] !shadow-none focus:!border-forest-700 focus:!ring-0\" id=\"general-email\" type=\"email\" autoComplete=\"email\" placeholder=\"you@example.com\" required=\"\" name=\"email\"/></div></div><div><label for=\"general-phone\" class=\"!mb-0 text-xs font-semibold text-stone-500\">Phone or WhatsApp <span class=\"font-normal text-stone-400\">(optional)</span></label><input class=\"w-full !rounded-none !border-x-0 !border-t-0 !border-stone-300 !bg-transparent !px-0 !py-3 text-[15px] !shadow-none focus:!border-forest-700 focus:!ring-0\" id=\"general-phone\" type=\"tel\" autoComplete=\"tel\" placeholder=\"Include your country code\" name=\"phone\"/></div><div><label for=\"general-message\" class=\"!mb-2 text-xs font-semibold text-stone-500\">Tell us a little more</label><textarea class=\"w-full resize-none !rounded-[1.25rem] !border-stone-200 !bg-[#fbf8f1] !px-4 !py-4 text-[15px] leading-7 focus:!border-forest-600 focus:!ring-4 focus:!ring-forest-600/10\" id=\"general-message\" name=\"message\" rows=\"5\" placeholder=\"How can we help with your visit?\" required=\"\"></textarea></div><div class=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\"><p class=\"flex max-w-xs items-start gap-2 text-xs leading-5 text-stone-500\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check mt-0.5 shrink-0 text-forest-700\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>This is an enquiry only. No payment is collected here.</p><button class=\"btn-primary shrink-0\" type=\"submit\" tabindex=\"0\">Send enquiry<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div></form></div></div></div></div></section><!--$--><!--/$--></main><footer class=\"overflow-hidden bg-forest-950 text-white\"><div class=\"mx-auto max-w-[90rem] px-5 py-14 lg:px-10 lg:py-20\"><div class=\"grid gap-10 border-b border-white/10 pb-14 lg:grid-cols-[.65fr_1.35fr] lg:items-end lg:pb-16\"><a aria-label=\"Tiffin Home and Restaurant, home page\" class=\"group w-fit\" href=\"/\"><span class=\"relative block h-20 w-20 sm:h-24 sm:w-24\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain brightness-0 invert transition-transform duration-500 ease-out group-hover:rotate-[-3deg] group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\"